# ============================================================
# Bhagwat Library Backend — Environment Variables Example
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values for your environment
# 3. NEVER commit the real .env to git
# ============================================================

# --- Server ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Leave empty to allow ALL origins (open dev/testing mode).
# Example: http://localhost:5173,https://bhagwat-library.vercel.app
ALLOWED_ORIGINS=https://bhagwat-library-free.vercel.app,http://localhost:5173

# --- Optional API Key Protection ---
# Set a strong random string to protect all /api/* routes.
# Leave as the placeholder value to disable enforcement.
API_KEY=your_optional_api_key_here

# --- WhatsApp Session Storage (MongoDB RemoteAuth) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bhagwat_library?retryWrites=true&w=majority
SESSION_NAME=library-session
WHATSAPP_SESSION_PATH=.wwebjs_auth

# --- Puppeteer / Google Chrome Path (Optional) ---
# Custom Chrome executable path if not in standard default Windows / system locations
# Example on Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=


# --- Firebase Admin SDK (if backend needs direct Firestore access) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase to MongoDB Backup System (Optional Settings) ---
# Database name to use for backup (defaults to the database in MONGODB_URI)
# MONGODB_BACKUP_DB=bhagwat_library
# Queue retry interval in milliseconds (defaults to 30000)
# BACKUP_RETRY_INTERVAL_MS=30000

# --- Cloudinary (optional - for cloud image/PDF storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT Secret (if auth is added in future) ---
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
