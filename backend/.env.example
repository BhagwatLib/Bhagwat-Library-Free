# ============================================================
# Bhagwat Library Backend — Environment Variables Example
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values for your environment
# 3. NEVER commit the real .env to git
# ============================================================

# --- Server ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Leave empty to allow ALL origins (open dev/testing mode).
# Example: http://localhost:5173,https://bhagwat-library.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# --- Optional API Key Protection ---
# Set a strong random string to protect all /api/* routes.
# Leave as the placeholder value to disable enforcement.
API_KEY=your_optional_api_key_here

# --- WhatsApp Session Storage ---
# Absolute or relative path where whatsapp-web.js stores its LocalAuth session.
# Leave empty to use default: backend/.wwebjs_auth
WHATSAPP_SESSION_PATH=

# --- Firebase Admin SDK (if backend needs direct Firestore access) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (optional - for cloud image/PDF storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT Secret (if auth is added in future) ---
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
